# Copy to .env. Never commit credentials. Only the selected provider needs a key/model.
LLM_PROVIDER=gemini
# Providers: gemini | openrouter | openai. Native OpenAI is optional.

# Google Gemini: use a model available to your account.
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenRouter: use the complete provider/model identifier available to your account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional native OpenAI provider; account access and API credits are not verified.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Required when selecting openai: none | low | medium | high | xhigh | max.
OPENAI_REASONING_EFFORT=low

# Shared generation parameters: finite temperature in [0, 2], positive token limit.
# A model may impose narrower limits; confirm compatibility before a live evaluation.
# Native OpenAI only sends temperature when reasoning effort is none.
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=512
# For native OpenAI this includes reasoning and visible output; consider 2048 for a live trial.
# GPT-6 Luna accepts at most 128000 output tokens. A larger budget can increase cost.

# Per-request timeout in seconds (>= 0.001), not an end-to-end classification deadline.
LLM_TIMEOUT_SECONDS=30

# Prompt version
PROMPT_VERSION=triage_v1

# Additional structured-output attempts; 3 means at most 4 generation rounds.
# Transport retries are separate: retry_transient() allows 2 retries per round.
# All provider SDKs have automatic retries disabled.
LLM_MAX_RETRIES=3

# Append-only operational metrics; relative paths resolve from the working directory.
METRICS_PATH=data/metrics.jsonl
