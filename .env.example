
# Nubbix AI Triage — Example configuration
# Copy this file to .env and fill in your own API keys.

# Active LLM backend: gemini | openrouter
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# LLM generation parameters
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=512

# Prompt version
PROMPT_VERSION=triage_v1

# Retry configuration
LLM_MAX_RETRIES=3

# Runtime metrics
METRICS_PATH=data/metrics.jsonl
